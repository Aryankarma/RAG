# INFO, DEBUG, WARNING
LOG_LEVEL=INFO

COHERE_API_KEY=your_cohere_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENV=your_pinecone_environment
PINECONE_INDEX=your_pinecone_index_name

# Optional Pinecone namespaces
PINECONE_NAMESPACE_CHUNKS=chunks
PINECONE_NAMESPACE_DOCS=docs

# Optional CORS
FRONTEND_PRODUCTION_URL=https://your-frontend-domain.com

# --- Email (SMTP) — optional; needed to actually send mail from the send_email tool ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Optional display name for From:
EMAIL_FROM_NAME=

# If true, send_email may send without confirm=true (use only in trusted environments)
EMAIL_SEND_ENABLED=true

# Comma-separated recipient email domains allowed (empty = any domain)
EMAIL_ALLOWLIST_DOMAINS=
